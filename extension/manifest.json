{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.steampowered.com/*",
    "https://partner.steam-api.com/*",
    "https://steamcommunity.com/*",
    "https://store.steampowered.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*",
        "https://steamcommunity.com/profiles/*",
        "https://steamcommunity.com/id/*"
      ],
      "js": [
        "page-vars.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://store.steampowered.com/*",
        "https://steamcommunity.com/profiles/*",
        "https://steamcommunity.com/id/*"
      ],
      "js": [
        "content/bootstrap.js",
        "content/config.js",
        "content/store-context.js",
        "content/i18n.js",
        "content/styles.js",
        "content/http.js",
        "content/format.js",
        "content/panel-shell.js",
        "content/menu-state.js",
        "content/panel-events.js",
        "content/price-utils.js",
        "content/store-assets.js",
        "content/state-store.js",
        "content/load-states.js",
        "content/cover-load-flow.js",
        "content/price-load-flow.js",
        "content/rate-limit-controller.js",
        "content/raw-data-store.js",
        "content/details-renderer.js",
        "content/compare-dialog.js",
        "content/summary-renderer.js",
        "content/copy-actions.js",
        "content/cache-actions.js",
        "content/poster-settings.js",
        "content/store-item-batch.js",
        "content/store-api.js",
        "content/shareability-flow.js",
        "content/posters.js",
        "content/poster-dialog.js",
        "content/steam-api.js",
        "content/family-library-flow.js",
        "content/analysis-flow.js",
        "content/report-model.js",
        "content/library-compare.js",
        "content/history-store.js",
        "content/analysis-session-store.js",
        "content/app.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
